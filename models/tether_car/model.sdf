    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_wheel_steering_joint</right_steering_joint>
      <wheel_base>2.86</wheel_base>
      <wheel_separation>1.572</wheel_separation>
      <kingpin_width>1.52</kingpin_width>
      <wheel_radius>0.31265</wheel_radius>
      <steering_limit>0.5</steering_limit>
      <steer_p_gain>2.0</steer_p_gain>
      <min_velocity>-2</min_velocity>
      <max_velocity>2</max_velocity>
      <min_acceleration>-1</min_acceleration>
      <max_acceleration>1</max_acceleration>
      <topic>/model/tether_car/cmd_vel</topic>
      <odom_topic>/model/tether_car/odometry</odom_topic>
      <tf_topic>/model/tether_car/tf</tf_topic>
      <frame_id>car/odom</frame_id>
      <child_frame_id>car/chassis</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
