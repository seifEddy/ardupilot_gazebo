    <joint name="anchor_joint" type="fixed">
      <parent>world</parent><child>base_link</child>
    </joint>
    <joint name="drum_joint" type="revolute">
      <parent>base_link</parent><child>drum</child>
      <axis>
        <xyz>0 1 0</xyz>
        <!-- Travel limits are enforced in metres by the winch controller. -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>
