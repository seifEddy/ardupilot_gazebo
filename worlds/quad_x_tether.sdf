<?xml version="1.0"?>
<sdf version="1.9">
  <world name="quad_x_tether_field">
    <physics name="default" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>

    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <scene>
      <ambient>0.50 0.53 0.57 1</ambient>
      <background>0.70 0.77 0.84 1</background>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <diffuse>0.92 0.89 0.82 1</diffuse>
      <specular>0.28 0.28 0.28 1</specular>
      <direction>-0.45 0.30 -0.84</direction>
    </light>

    <model name="test_field">
      <static>true</static>
      <link name="ground">
        <collision name="surface">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry>
          <material>
            <ambient>0.28 0.33 0.37 1</ambient>
            <diffuse>0.28 0.33 0.37 1</diffuse>
          </material>
        </visual>
        <visual name="pad_border">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><cylinder><radius>0.90</radius><length>0.001</length></cylinder></geometry>
          <material><diffuse>0.96 0.69 0.26 1</diffuse></material>
          <cast_shadows>false</cast_shadows>
        </visual>
        <visual name="pad_surface">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><cylinder><radius>0.86</radius><length>0.001</length></cylinder></geometry>
          <material><diffuse>0.10 0.15 0.20 1</diffuse></material>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://quad_x_with_gimbal</uri>
      <pose degrees="true">0 0 0.1031075405 0 0 90</pose>
    </include>
    <include>
      <uri>model://tether_station</uri>
      <pose>-1.4 0 0 0 0 0</pose>
    </include>

    <plugin filename="TetherPlugin" name="TetherPlugin">
      <station_model>tether_station</station_model>
      <vehicle_link>quad_x_with_gimbal::quad_x::base_link</vehicle_link>
      <anchor_offset>0 0 0.32</anchor_offset>
      <vehicle_offset>-0.08 0 -0.06</vehicle_offset>
      <drum_radius>0.08</drum_radius>
      <initial_length>3.1</initial_length>
      <min_length>1.0</min_length>
      <max_length>500.0</max_length>
      <max_payout_speed>1.0</max_payout_speed>
      <!-- Drum brake settings. Cable damping below acts on tether stretch. -->
      <breakaway_tension>0.0025</breakaway_tension>
      <brake_damping>0.0025</brake_damping>
      <stiffness>0.1</stiffness>
      <damping>0.04</damping>
      <max_tension>15.0</max_tension>
    </plugin>
  </world>
</sdf>
